# URL privada do servidor OpenCode persistente (VM/container), nunca uma função serverless
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
# Token pessoal da aplicação, se habilitar autenticação no proxy/API
APP_ACCESS_TOKEN=
# GitHub fine-grained token com Contents: Read and write nos repositórios escolhidos
GITHUB_TOKEN=
# Diretório de skills do agente no executor
OPENCODE_SKILLS_DIR=/workspace/.agents/skills
# Para upload de 10 GB, configurar armazenamento compatível com S3/R2 e multipart no executor
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
